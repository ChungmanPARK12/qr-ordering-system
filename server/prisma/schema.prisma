generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PrintStatus {
  NOT_REQUIRED
  PENDING
  PRINTED
  FAILED
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum OptionSelectionType {
  SINGLE
  MULTIPLE
}

model Restaurant {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  phone       String?
  address     String?
  isActive    Boolean @default(true)

  adminUsers     AdminUser[]
  tables         RestaurantTable[]
  categories     Category[]
  menuItems      MenuItem[]
  optionGroups   OptionGroup[]
  customerOrders CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([restaurantId])
}

model RestaurantTable {
  id          String      @id @default(cuid())
  name        String
  qrCode      String?     @unique
  tableNumber Int
  capacity    Int?
  status      TableStatus @default(ACTIVE)
  isActive    Boolean     @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerOrders CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([restaurantId, tableNumber])
  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)
  isSoldOut   Boolean @default(false)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  optionGroups OptionGroup[]
  orderItems   CustomerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([categoryId, name])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, sortOrder])
}

model OptionGroup {
  id            String              @id @default(cuid())
  name          String
  selectionType OptionSelectionType
  isRequired    Boolean             @default(false)
  minSelection  Int                 @default(0)
  maxSelection  Int                 @default(1)
  sortOrder     Int                 @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems   MenuItem[]
  optionItems OptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

model OptionItem {
  id              String @id @default(cuid())
  name            String
  additionalPrice Int    @default(0)
  sortOrder       Int    @default(0)

  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([optionGroupId, name])
  @@index([optionGroupId])
  @@index([optionGroupId, sortOrder])
}

model CustomerOrder {
  id            String        @id @default(cuid())
  orderNumber   String
  orderStatus   OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  printStatus   PrintStatus   @default(NOT_REQUIRED)

  customerNote   String?
  subtotal       Int
  discountAmount Int @default(0)
  totalAmount    Int

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId String
  table   RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  items     CustomerOrderItem[]
  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([tableId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([printStatus])
}

model CustomerOrderItem {
  id                String @id @default(cuid())
  quantity          Int
  menuNameSnapshot  String
  unitPriceSnapshot Int
  lineTotal         Int
  customerNote      String?

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([customerOrderId])
  @@index([menuItemId])
}

model PrintJob {
  id            String         @id @default(cuid())
  status        PrintJobStatus @default(PENDING)
  attemptCount  Int            @default(0)
  maxAttempts   Int            @default(3)
  failureReason String?
  lastTriedAt   DateTime?
  printedAt     DateTime?
  failedAt      DateTime?

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([customerOrderId])
  @@index([createdByAdminId])
  @@index([status])
}